# botwatch backend — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.

# --- Core ---
PORT=5000
NODE_ENV=production
# Public origin of the site, used to build Stripe success/cancel redirect URLs.
# If unset, these are derived from the incoming request host.
PUBLIC_BASE_URL=https://botwatch.xyz
FRONTEND_ORIGIN=https://botwatch.xyz
SITE_URL=https://botwatch.xyz

# --- Database (PostgreSQL) ---
PG_USER=botwatch_user
PG_HOST=localhost
PG_DATABASE=botwatch
PG_PASSWORD=
PG_PORT=5432

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Optional enrichment integrations (skip cleanly if unset) ---
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

# ============================================================================
# Stripe billing (Phase 3.4) — REPLACE THESE PLACEHOLDERS after you create your
# Stripe account. Until STRIPE_SECRET_KEY is set, all /api/billing endpoints
# return 503 "not configured" and the rest of the app is unaffected.
# ============================================================================

# Secret API key from Stripe → Developers → API keys (use sk_test_... while testing).
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Signing secret for your webhook endpoint, from Stripe → Developers → Webhooks.
# Point the webhook at:  https://botwatch.xyz/api/v1/../billing/webhook
#   i.e.  https://botwatch.xyz/api/billing/webhook
# and subscribe it to the `checkout.session.completed` event.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Recurring Price IDs (Stripe → Products). One per paid tier. A tier without a
# Price ID is shown as "coming soon" on the pricing page and can't be checked out.
STRIPE_PRICE_PRO=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE=price_REPLACE_ME
